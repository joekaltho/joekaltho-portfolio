# Where "Send message" goes if Supabase is not configured (opens the visitor's mail app)
VITE_CONTACT_EMAIL=

# Optional: saves contact messages to your Supabase project instead
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Table that receives { name, email, message }. Match it to supabase/schema.sql
VITE_SUPABASE_CONTACT_TABLE=contact_messages
